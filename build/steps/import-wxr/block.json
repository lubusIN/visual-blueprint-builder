{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "playground-step/import-wxr",
  "version": "0.1.0",
  "title": "Import Wxr",
  "category": "data",
  "description": "Imports a WXR file into WordPress.",
  "example": {},
  "supports": {
    "html": false,
    "customClassName": false
  },
  "attributes": {
    "step": {
      "type": "string",
      "default": "importWxr"
    },
    "file": {
      "type": "object",
      "default": {
        "resource": "url",
        "url": ""
      },
      "properties": {
        "resource": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "fetchAttachments": {
      "type": "boolean",
      "default": true
    },
    "rewriteUrls": {
      "type": "boolean",
      "default": true
    },
    "importComments": {
      "type": "boolean",
      "default": true
    },
    "defaultAuthorUsername": {
      "type": "string",
      "default": "admin"
    },
    "authorsMode": {
      "type": "string",
      "default": "default-author",
      "enum": [
        "default-author",
        "create",
        "map"
      ]
    },
    "authorsMap": {
      "type": "object"
    },
    "importUsers": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "visual-blueprint-builder",
  "editorScript": "file:./index.js"
}