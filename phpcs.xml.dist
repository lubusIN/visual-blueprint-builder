<?xml version="1.0"?>
<ruleset name="Visual Blueprint Builder Coding Standards">
	<description>PHP_CodeSniffer ruleset for Visual Blueprint Builder.</description>

	<!-- Scan all files in directory and subdirectories -->
	<file>visual-blueprint-builder.php</file>
	<file>inc</file>
	<file>tests</file>

	<!-- Exclude paths -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/_playground/*</exclude-pattern>

	<!-- Pass flags: p=progress, s=sniff codes -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- PHP version compatibility check (supports PHP 7.4 and higher) -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Include WordPress Coding Standards -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!-- Set minimum WordPress version -->
	<config name="minimum_wp_version" value="6.8"/>

	<!-- Verify text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="visual-blueprint-builder"/>
			</property>
		</properties>
	</rule>

	<!-- Allow modern short array syntax [] for PHP 7.4+ -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>

	<!-- Allow filenames that don't strictly prefix with class- if namespaced -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>
</ruleset>
