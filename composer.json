{
	"name": "lubusin/visual-blueprint-builder",
	"description": "Design playground blueprints with a specialized block editor interface in WordPress.",
	"keywords": [
		"wordpress",
		"plugin",
		"block-editor",
		"playground",
		"blueprint",
		"editor"
	],
	"homepage": "https://lubus.in",
	"license": "MIT",
	"authors": [
		{
			"name": "Punit Verma",
			"email": "punit@lubus.in",
			"homepage": "https://lubus.in"
		},
		{
			"name": "Ajit Bohra",
			"email": "ajit@lubus.in",
			"homepage": "https://lubus.in"
		}
	],
	"type": "wordpress-plugin",
	"support": {
		"issues": "https://github.com/lubusIN/visual-blueprint-builder/issues",
		"source": "https://github.com/lubusIN/visual-blueprint-builder"
	},
	"extra": {
		"installer-name": "visual-blueprint-builder"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require": {
		"php": ">=7.4",
		"composer/installers": "^2.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-coding-standards/wpcs": "^3.1",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"scripts": {
		"lint": "phpcs",
		"format": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit 512M"
	},
	"autoload": {
		"classmap": [
			"inc/"
		]
	}
}
